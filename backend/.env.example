APP_NAME="Wellbeing Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# stderr keeps container logs visible via `docker compose logs`
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wellbeing
DB_USERNAME=wellbeing
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=wellbeing

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@wellbeing.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080

CORS_ALLOWED_ORIGINS=http://localhost:8080
# Comma-separated Chrome extension IDs allowed to use CORS (see chrome://extensions).
# The bundled extension uses host_permissions and works without this.
CORS_ALLOWED_EXTENSION_IDS=

VITE_APP_NAME="${APP_NAME}"

# LLM (OpenAI-compatible API for dashboard Analysis tab)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-flash-latest
# BotHub: OPENAI_BASE_URL=https://openai.bothub.chat/v1
OPENAI_TIMEOUT=300
# Для моделей с thinking/reasoning (qwen3 и т.п.) ставьте 4096+, иначе content может быть пустым
OPENAI_MAX_TOKENS=4096
