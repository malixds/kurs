# Docker Compose environment (root). Copy to .env: cp .env.example .env
# Laravel application config lives in backend/.env (see backend/.env.example).

APP_ENV=local
APP_DEBUG=true

# Host port for nginx (http://localhost:APP_PORT)
APP_PORT=8080

DB_DATABASE=wellbeing
DB_USERNAME=wellbeing
DB_PASSWORD=secret
# Host port mapping for PostgreSQL
DB_PORT=5432

# Host port mapping for Redis
REDIS_PORT=6379
# Set a non-empty value to require AUTH on Redis (mirror it in backend/.env)
REDIS_PASSWORD=
